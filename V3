                    local screenPos, on = Camera:WorldToViewportPoint(p.Character[Config.TargetPart].Position)
                    if on then
                        local mag = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if mag < d then t = p; d = mag end
                    end
                end
            end
        end
        Config.Target = t; Config.IsHolding = true
    end
end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == KeyMap[Config.ActivationMode] or i.KeyCode == KeyMap[Config.ActivationMode] then Config.IsHolding = false end end)

RunService.RenderStepped:Connect(function()
    if Config.Enabled and Config.IsHolding and Config.Target and Config.Target.Character then
        local char = Config.Target.Character
        local part = char:FindFirstChild(Config.TargetPart)
        
        -- [[ UNLOCK IF DEAD, RAGDOLLED, OR KNOCKED OUT ]]
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local bodyEffects = char:FindFirstChild("BodyEffects")
        local koTag = bodyEffects and (bodyEffects:FindFirstChild("KO") or bodyEffects:FindFirstChild("K.O"))
        local isKO = koTag and koTag.Value == true
        
        if (humanoid and humanoid.Health <= 1) or isKO or (humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Physics or humanoid:GetState() == Enum.HumanoidStateType.Dead)) then
            Config.Target = nil -- Instantly unlocks
            return
        end
        -- [[ END OF UNLOCK CODE ]]

        if part then
            if Config.WallCheck and #Camera:GetPartsObscuringTarget({Camera.CFrame.Position, part.Position}, {LocalPlayer.Character, char}) > 0 then return end
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, part.Position + (part.Velocity * Config.Prediction)), Config.Smoothness)
        end
    end
end)

