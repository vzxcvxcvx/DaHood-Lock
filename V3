local function createSlider(name, min, max, cfgKey)
    local f = Instance.new("Frame", SettingsScroll); f.Size = UDim2.new(0.95, 0, 0, 65); f.BackgroundTransparency = 1
    local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, 0, 0, 30); l.Text = name .. ": " .. string.format("%.3f", Config[cfgKey]); l.TextColor3 = Color3.new(1, 1, 1); l.Font = Enum.Font.GothamBold; l.TextSize = 18; l.BackgroundTransparency = 1; addOutline(l)
    local bar = Instance.new("Frame", f); bar.Size = UDim2.new(1, 0, 0, 6); bar.Position = UDim2.new(0, 0, 0.75, 0); bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    local k = Instance.new("Frame", bar); k.Size = UDim2.new(0, 20, 0, 20); k.AnchorPoint = Vector2.new(0.5, 0.5); k.Position = UDim2.new((Config[cfgKey]-min)/(max-min), 0, 0.5, 0); k.BackgroundColor3 = Color3.new(1,1,1); Instance.new("UICorner", k).CornerRadius = UDim.new(1, 0)
    
    local move = false
    k.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then move = true; Config.IsInteracting = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then move = false; Config.IsInteracting = false end end)
