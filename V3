local activeFlakes = {}
local isSnowing = false

-- Lightweight loop to drift clean little white dots down your UI
local function startSnowEffect()
    if isSnowing then return end
    isSnowing = true
    
    task.spawn(function()
        while isSnowing and MainFrame.Visible == true do
            task.wait(0.12) -- Slightly increased delay between spawns so it's less crowded
            
            local dot = Instance.new("TextLabel")
            dot.BackgroundTransparency = 1
            dot.Text = "•"
            dot.TextSize = math.random(10, 14) -- Slightly smaller sizes so they look neat and clean
            dot.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            -- [[ FIXED TRANSPARENCY SHIFT ]]
            -- Originally 0.2 to 0.6. Changing it to 0.65 to 0.88 makes them much more transparent and hidden!
            dot.TextTransparency = math.random(65, 88) / 100 
            
            dot.Size = UDim2.new(0, 12, 0, 12)
            dot.Position = UDim2.new(math.random(), 0, -0.05, 0)
            dot.ZIndex = SnowflakeContainer.ZIndex
            dot.Parent = SnowflakeContainer
            
            table.insert(activeFlakes, dot)
            
            local fallTime = math.random(30, 55) / 10 -- Made them drift down slightly slower for a calmer vibe
            local drift = (math.random() - 0.5) * 0.08
            
            local dropTween = TweenService:Create(dot, TweenInfo.new(fallTime, Enum.EasingStyle.Linear), {
                Position = UDim2.new(dot.Position.X.Scale + drift, 0, 1.05, 0)
            })
            dropTween:Play()
            
            -- Automated garbage collection clean up
            dropTween.Completed:Connect(function()
                dot:Destroy()
                local idx = table.find(activeFlakes, dot)
                if idx then table.remove(activeFlakes, idx) end
            end)
        end
    end)
end


local function stopSnowEffect()
    isSnowing = false
    for _, dot in pairs(activeFlakes) do
        TweenService:Create(dot, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
        task.delay(0.15, function() dot:Destroy() end)
    end
    table.clear(activeFlakes)
end

-- [[ THE TOGGLE MENU FUNCTION ]]
local function toggleMenu()
    Config.Visible = not Config.Visible
    
    local startSize = Config.Visible and UDim2.new(0, 150, 0, 95) or MainFrame.Size
    local targetSize = Config.Visible and UDim2.new(0, 860, 0, 540) or UDim2.new(0, 150, 0, 95)
    local targetTransparency = Config.Visible and 0.45 or 1
    
    if Config.Visible then
        MainFrame.Size = startSize
        MainFrame.BackgroundTransparency = 1 
        MainFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 10)
        MainFrame.Visible = true
        
        task.defer(function()
            if Config.Visible then
                startSnowEffect()
            end
        end)
    else
        stopSnowEffect()
    end
    
    local sizeTween = TweenService:Create(MainFrame, TweenInfo.new(
        0.45, 
        Enum.EasingStyle.Back, 
        Config.Visible and Enum.EasingDirection.Out or Enum.EasingDirection.In
    ), {Size = targetSize})
    
    local transparencyTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = targetTransparency
    })
    
    sizeTween:Play()
    transparencyTween:Play()
    
    sizeTween.Completed:Connect(function()
        if not Config.Visible then
            MainFrame.Visible = false
        end
    end)
end

