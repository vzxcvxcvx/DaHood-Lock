-- // ESP LOGIC (PERSISTENT & CYAN)
local ActiveESP = {}

local function applyESP(p)
    local function doESP(char)
        if not char then return end
        task.wait(0.3) -- Wait for character assembly
        
        -- Cyan Highlight
        local h = char:FindFirstChild("DHL_ESP") or Instance.new("Highlight")
        h.Name = "DHL_ESP"
        h.FillColor = Color3.fromRGB(0, 255, 255) -- Cyan
        h.OutlineColor = Color3.new(1, 1, 1)
        h.Parent = char
        
        -- Cyan Tag
        local head = char:WaitForChild("Head", 5)
        if head then
            local b = head:FindFirstChild("DHL_TAG") or Instance.new("BillboardGui")
            b.Name = "DHL_TAG"
            b.Size = UDim2.new(0, 200, 0, 50)
            b.AlwaysOnTop = true
            b.ExtentsOffset = Vector3.new(0, 3, 0)
            b.Parent = head
            
            local l = b:FindFirstChildOfClass("TextLabel") or Instance.new("TextLabel")
            l.Size = UDim2.new(1, 0, 1, 0)
            l.BackgroundTransparency = 1
            l.Text = p.DisplayName
            l.TextColor3 = Color3.fromRGB(0, 255, 255) -- Cyan
            l.Font = Enum.Font.GothamBold
            l.TextSize = 18
            l.Parent = b
            if not l:FindFirstChildOfClass("UIStroke") then addOutline(l) end
        end
    end
    
    if ActiveESP[p.UserId] then ActiveESP[p.UserId]:Disconnect() end
    ActiveESP[p.UserId] = p.CharacterAdded:Connect(doESP)
    if p.Character then doESP(p.Character) end
end

local function removeESP(p)
    if ActiveESP[p.UserId] then 
        ActiveESP[p.UserId]:Disconnect()
        ActiveESP[p.UserId] = nil
    end
    if p.Character then
        if p.Character:FindFirstChild("DHL_ESP") then p.Character.DHL_ESP:Destroy() end
        local head = p.Character:FindFirstChild("Head")
        if head and head:FindFirstChild("DHL_TAG") then head.DHL_TAG:Destroy() end
    end
end

