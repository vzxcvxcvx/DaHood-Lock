-- This completely hijacks the frame settings on execution, forcing the perfect transparency before you can even hit a single button.
local function forceInitUI()
    MainFrame.BackgroundTransparency = 0.45
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 10)
    MainFrame.Size = UDim2.new(0, 860, 0, 540)
    
    if Config.Visible == nil then Config.Visible = true end
    MainFrame.Visible = Config.Visible
    
    if Config.Visible then
        task.defer(startSnowEffect)
    else
        stopSnowEffect()
    end
end

