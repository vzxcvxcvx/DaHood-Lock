local SyncToggles = {}
local function updateTheme()
    local main = Color3.fromHSV(Config.Hue, Config.Sat, Config.Val)
    local darkShade = Color3.fromHSV(Config.Hue, Config.Sat, Config.Val * 0.4)
    Config.MainColor = main
    BGGradient.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.new(0,0,0)), ColorSequenceKeypoint.new(1, main)})
    OuterGlow.ImageColor3 = main
    MainTitle.TextColor3 = main
    Subtitle.TextColor3 = main
    for btn, cfgKey in pairs(SyncToggles) do
        btn.BackgroundColor3 = Config[cfgKey] and darkShade or Color3.fromRGB(35, 35, 35)
        btn.Text = (cfgKey == "Enabled" and "Camlock System: " or "Wall Check: ") .. (Config[cfgKey] and "ON" or "OFF")
    end
    SettingsScroll.ScrollBarImageColor3 = darkShade; updateLists()
end

