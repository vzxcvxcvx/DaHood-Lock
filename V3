local function updateLists()
    for _, s in pairs({SpectateScroll, CamlockScroll}) do
        for _, c in pairs(s:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if Config.SearchText ~= "" and not string.find(p.DisplayName:lower(), Config.SearchText:lower()) then continue end
        
        local function createBtn(scroll, isSelect)
            local b = Instance.new("TextButton", scroll)
            b.Size = UDim2.new(1, -10, 0, 50)
            b.BackgroundColor3 = (isSelect and Config.SelectedPlayers[p.UserId]) and Config.MainColor or Color3.fromRGB(25, 25, 25)
            b.Text = "  " .. p.DisplayName; b.TextColor3 = (isSelect and Config.SelectedPlayers[p.UserId]) and Color3.new(0,0,0) or Color3.new(1,1,1)
            b.TextXAlignment = Enum.TextXAlignment.Left; b.Font = Enum.Font.GothamBold; b.TextSize = 20
            Instance.new("UICorner", b); addOutline(b)
            return b
        end

        createBtn(SpectateScroll, false).MouseButton1Click:Connect(function() Camera.CameraSubject = p.Character.Humanoid end)
        createBtn(CamlockScroll, true).MouseButton1Click:Connect(function()
            Config.SelectedPlayers[p.UserId] = not Config.SelectedPlayers[p.UserId]
            if Config.SelectedPlayers[p.UserId] then applyESP(p) else removeESP(p) end
            updateLists()
        end)
    end
end

